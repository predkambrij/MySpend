{
  "name": "pwa-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal single-user PWA starter",
  "main": "server.js",
  "scripts": {
    "build": "tailwindcss -i - -o ./public/styles.css --minify",
    "create-config": "node scripts/create-config.js",
